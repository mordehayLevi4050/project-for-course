        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES \"groups\" (id), \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL, \"member_seq\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"modified_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"group_id\", \"name_key\"), UNIQUE (\"group_id\", \"member_seq\"), UNIQUE (\"group_id\", \"id\"));"
